import QtQuick.tooling 1.2

// Static description of the Pulsar QML module, consumed by qmllint / qmlls / Qt Creator.
// The types themselves are registered at runtime with qmlRegisterSingletonInstance().
Module {
    Component {
        name: "Pulsar"
        prototype: "QObject"
        exports: ["Pulsar/Pulsar 1.0"]
        isSingleton: true

        Method {
            name: "emit"
            type: "qint64"
            Parameter { name: "method"; type: "QString" }
            Parameter { name: "params"; type: "QVariant" }
        }

        Method {
            name: "invoke"
            type: "qint64"
            Parameter { name: "method"; type: "QString" }
            Parameter { name: "params"; type: "QVariant" }
        }

        Method {
            name: "call"
            type: "QJSValue"
            Parameter { name: "method"; type: "QString" }
            Parameter { name: "params"; type: "QVariant" }
        }

        Method {
            name: "clipboardWrite"
            Parameter { name: "text"; type: "QString" }
        }

        Method {
            name: "openFile"
            type: "QString"
            Parameter { name: "title"; type: "QString" }
            Parameter { name: "filter"; type: "QString" }
            Parameter { name: "dir"; type: "QString" }
        }

        Method {
            name: "saveFile"
            type: "QString"
            Parameter { name: "title"; type: "QString" }
            Parameter { name: "filter"; type: "QString" }
            Parameter { name: "dir"; type: "QString" }
        }

        Method {
            name: "message"
            Parameter { name: "title"; type: "QString" }
            Parameter { name: "text"; type: "QString" }
        }

        Method {
            name: "trayAvailable"
            type: "bool"
        }

        Method {
            name: "setTrayIcon"
            Parameter { name: "path"; type: "QString" }
        }

        Method {
            name: "setTrayTooltip"
            Parameter { name: "text"; type: "QString" }
        }

        Method {
            name: "setTrayMenu"
            Parameter { name: "items"; type: "QVariantList" }
        }

        Method {
            name: "hideTray"
        }

        Method {
            name: "clipboardText"
            type: "QString"
        }

        Method {
            name: "diagnostics"
            type: "QString"
        }

        Method {
            name: "restart"
        }

        Signal {
            name: "ready"
        }

        Signal {
            name: "log"
            Parameter { name: "level"; type: "QString" }
            Parameter { name: "message"; type: "QString" }
            Parameter { name: "source"; type: "QString" }
        }

        Signal {
            name: "response"
            Parameter { name: "id"; type: "qint64" }
            Parameter { name: "result"; type: "QVariant" }
            Parameter { name: "error"; type: "QVariant" }
        }
    }

    Component {
        name: "Store"
        prototype: "QQmlPropertyMap"
        exports: ["Pulsar/Store 1.0"]
        isSingleton: true
    }
}
