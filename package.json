{
  "name": "pulsar-monorepo",
  "version": "0.1.0",
  "author": "Riclud",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "cli": "bun cli/index.ts",
    "build": "zig build",
    "run": "zig build run",
    "start": "bun --filter hello start",
    "editor-config": "zig build editor-config",
    "clean": "rm -rf zig-out .zig-cache host/compile_flags.txt",
    "setup": "bun install && zig build editor-config",
    "test": "bun test core && bun scripts/smoke.ts",
    "test:unit": "bun test core",
    "typecheck": "tsc --noEmit",
    "version:check": "bun scripts/version-check.ts",
    "fmt": "bun run fmt:ts && bun run fmt:zig && bun run fmt:qml",
    "fmt:ts": "prettier --write .",
    "fmt:zig": "zig fmt build.zig bridge",
    "fmt:qml": "bun scripts/qmlformat.ts",
    "fmt:check": "prettier --check . && zig fmt --check build.zig bridge && bun run version:check"
  },
  "workspaces": [
    "core/sdk",
    "cli",
    "examples/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
