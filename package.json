{
  "name": "pulsar-monorepo",
  "version": "2.1.0",
  "author": "Riclud",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "cli": "bun cli/index.ts",
    "build": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build",
    "run": "cmake --build build && ./build/bin/qml-host",
    "start": "bun --filter hello start",
    "editor-config": "cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && ln -sf build/compile_commands.json compile_commands.json",
    "clean": "rm -rf build compile_commands.json",
    "setup": "bun install && cmake -S . -B build",
    "test": "bun test core cli && bun scripts/portable.ts && bun scripts/embedded.ts && bun scripts/embedded-qml.ts && bun scripts/embedded-regressions.ts && bun scripts/error-overlay.ts && bun scripts/smoke.ts",
    "test:unit": "bun test core",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "version:check": "bun scripts/version-check.ts",
    "fmt": "bun run fmt:ts && bun run fmt:qml",
    "fmt:ts": "prettier --write .",
    "fmt:qml": "bun scripts/qmlformat.ts",
    "fmt:check": "prettier --check . && bun run version:check",
    "test:portable": "bun scripts/portable.ts",
    "test:embedded": "bun scripts/embedded.ts",
    "test:embedded:qml": "bun scripts/embedded-qml.ts",
    "test:embedded:regressions": "bun scripts/embedded-regressions.ts",
    "docs": "cd site && bun run build",
    "docs:dev": "cd site && bun run dev"
  },
  "workspaces": [
    "core/sdk",
    "cli",
    "examples/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "9",
    "prettier": "^3.9.9",
    "typescript-eslint": "8"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
