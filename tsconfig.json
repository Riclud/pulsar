{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "pulsar",
    "paths": {
      "pulsar": ["./core/sdk/index.ts"],
      "pulsar/jsx-runtime": ["./core/sdk/jsx-runtime.ts"],
      "pulsar/jsx-dev-runtime": ["./core/sdk/jsx-dev-runtime.ts"]
    },
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": [
    "node_modules",
    "cli/templates",
    "build",
    "build-*",
    "dist",
    ".cache",
    "examples/*/dist",
    "examples/*/build",
    "tests/apps/*/build",
    "site",
    "edge"
  ]
}
